    | C S D S | C S D S | C S D S | (SSSS)%(--) (SSSSSSBS)%(--) |
    | C S D S | C S D S | C S D S | C S D S |
    | C S D S | C S D S | C - - - | - - - - |
}

/* =============================================================
   VII. 間奏（b1: 8 小節）
   後搖神聖高潮！雙破音吉他與弦樂齊奏「32121」動機，
   大鼓與重鈸砸下最深沉的重拍，壯烈昇華！
   ============================================================= */

b1:DistGuitar-Lead@|-1| {
    <4*>
    | 0 3^ 2^ 1^ | 2^ 1^ - - | 0 3^ 2^ 1^ | 2^ 1^ - - | 0 3^ 2^ 1^ | 2^ 1^ - - | 0 3^ 2^ 1^ | 2^ 1^ 6 - | 
    | 0 3^ 2^ 1^ | 2^ 1^ - - | 0 3^ 2^ 1^ | 2^ 1^ - - | 0 3^ 2^ 1^ | 2^ 1^ - - | 0 3^ 2^ 1^ | 2^ 1^ - - | 
}

b1:DistGuitar-Left@|0| {
    <4*>
    | [4] - - - | [5] - - - | [3m] - - - | [6m] - - - |
    | [2m] - - - | [5] - - - | [1] - - - | [5] - - - |
    | [4] - - - | [5] - - - | [3m] - - - | [6m] - - - |
    | [2m] - - - | [5] - - - | [6m] - - - | - - - - |
}

b1:DistGuitar-Right@|0| {
    <4*>
    | [4_] - - - | [5_] - - - | [3_m] - - - | [6_m] - - - |
    | [2_m] - - - | [5_] - - - | [1_] - - - | [5_] - - - |
    | [4_] - - - | [5_] - - - | [3_m] - - - | [6_m] - - - |
    | [2_m] - - - | [5_] - - - | [6_m] - - - | - - - - |
}

b1:Bass@|0| {
    <4*>
    | 4__ - - - | 5__ - - - | 3__ - - - | 6__ - - - |
    | 2__ - - - | 5__ - - - | 1_ - - - | 5__ - - - |
    | 4__ - - - | 5__ - - - | 3__ - - - | 6__ - - - |
    | 2__ - - - | 5__ - - - | 6__ - - - | - - - - |
}

b1:Strings@|0| {
    <4*>
    | 6 - - - | 7 - - - | 1^ - - - | 3^ - - - |
    | 4^ - - - | 2^ - - - | 1^ - - - | 7 - - - |
    | 6 - - - | 7 - - - | 1^ - - - | 3^ - - - |
    | 4^ - - - | 5^ - - - | 6^ - - - | - - - - |
}

b1:Drum@|0| {

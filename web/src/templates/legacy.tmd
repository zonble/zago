    | C S D S | C S D S | C S D S | C S D S |
    | C S D S | C S D S | C S D S | C S D S |
    | C S D S | C S D S | C S D S | C S D S |
    | C S D S | C S D S | C S D S | B B B B |
}

/* =============================================================
   VIII. 尾聲：狂暴後的寂靜與餘震（Ending: 16 小節）
   音牆瞬間切斷！只剩一把清音電吉他的 Delay 殘響在虛空中迴盪，
   鋼琴獨自彈完最後幾句，最後一記 Emaj7 和弦慢慢冷卻，歸於永恆。
   ============================================================= */

end:piano@|0| {
    <4*>
    /*多  麼 希 望   我可   以                 多   麼希  望   我 能夠 */
    | 4 - 4 1 | 1^ - 4 6 | 5 - - -| - - - - | 2 - 2 5_ | 5 - 6 5 | 3 - - -| - - - - |
    /*多  麼 希 望   我    可以       對誰說    一 句          我 能 夠 */
    | 4 - 4 1 | 1^ - 7 6 | 5 3 - - | 6 5 5 3 | 5 2 - - | 0 - 1 7_ | 6_ -  - - | - - - - |
}

end:Guitar-Delay@|0| {
    <4*>
    | 1^ - - - | - - - - | 7 - - - | - - - - |
    | 6 - - - | - - - - | 5 - - - | - - - - |
    | 1^ - - - | - - - - | 7 - - - | - - - - |
    | 6 - - - | 7 - - - | 1^ - - - | - - - - |
}

end:Pad-Cosmos@|0| {
    <4*>
    | [4] - - - | - - - - | [5] - - - | - - - - |
    | [2m] - - - | - - - - | [3m] - - - | - - - - |
    | [4] - - - | - - - - | [5] - - - | - - - - |
    | [2m] - - - | [5] - - - | [1] - - - | - - - - |
}

end:Motif-Fadeout@|-1| {
    <4*>
    | 0 3 2 1 | 2 1 - - | 0 3 2 1 | 2 1 - - | 0 3 2 1 | 2 1 - - | 0 3 2 1 | 2 1 1 - | 
}


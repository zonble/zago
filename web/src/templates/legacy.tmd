::SCORE::
** Legacy (Post-Rock Epics Version) **
! = 120
? = E
<4/4>

/* =============================================================
   I. 序章：冷冽宇宙的微光（Intro: 8 小節）
   後搖滾式的極度空曠。清音電吉他帶著巨大 Delay 與 Reverb，
   像深空中的電波信號，環境氛圍 Pad 緩緩升起，鋼琴輕輕試探主題。
   ============================================================= */

intro:Guitar-Clean@|0| {
    <4*>
    /* 點狀清音延遲吉他，勾勒孤寂星空 */
    | 1^ - 5 - | 3 - 5 - | 1^ - 5 - | 3 - 5 - |
    | 1^ - 5 - | 3 - 5 - | 1^ - 7 - | 5 - - - |
}

intro:Piano-Solo@|0| {
    <4*>
    | 0 0 0 0 | 0 3 2 1 | 2 1 - - | - - - - |
    | 0 0 0 0 | 0 3 2 1 | 2 1 6_ - | - - - - |
}

intro:Pad-Cosmos@|0| {
    <4*>
    /* 宇宙微波背景輻射般的冷冽長音 */
    | [1] - - - | - - - - | [6m] - - - | - - - - |
    | [4] - - - | - - - - | [5] - - - | - - - - |
}

intro:Drum@|0| {
    <4*>
    | x - - - | - - - - | x - - - | - - - - |
    | x - - - | - - - - | x - - - | (xxxx)%(--) X - |
}

/* =============================================================
   II. 主歌一（v1: 16 小節）
   旋律原封不動（@|-1| 弱起進場）。
   極簡真空感：鼓組完全靜止，電吉他在高把位敲擊冰冷的自然泛音，
   貝斯只在關鍵處沉沉震動，呈現深不見底的思念。
   ============================================================= */

v1:piano@|-1| {
    <4*>
    /* 多希望  能 夠        一直       牽巨   人的手 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-)  2 1 | 2 1 5_ - |
    /* 一直在  燈  塔     照  耀    中*/
    | 0 3 2 3 | 5 - 3 - | 2 - 5 - | 3 - - - |
    /* 多希望  能 夠        一直      仰望   我的      英雄 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | (2 2)%(-) 1 5_ - |
    /*  永遠都  看   不     見    他們  凋 落*/
    | 0 3 2 1 | 7_ - 5_ - | 7_ - 2 3 | 1 6_ - - |
}

v1:Guitar-Clean@|0| {
    <4*>
    | 1^ - - - | 7 - - - | 6 - - - | 5 - - - |
    | 4 - - - | 3 - - - | 2 - - - | 5 - - - |
    | 1^ - - - | 7 - - - | 6 - - - | 5 - - - |
    | 4 - - - | 5 - - - | 6 - - - | 7 - - - |
}

v1:Bass-Sub@|0| {
    <4*>
    | 1_ - - - | 7__ - - - | 6__ - - - | 5__ - - - |
    | 4__ - - - | 3__ - - - | 2__ - - - | 5__ - - - |
    | 1_ - - - | 7__ - - - | 6__ - - - | 5__ - - - |
    | 4__ - - - | 5__ - - - | 6__ - - - | 5__ - - - |
}

v1:Strings-Ether@|0| {
    <4*>
    | 3 - - - | 2 - - - | 1 - - - | 7_ - - - |
    | 1 - - - | 1 - - - | 6_ - - - | 7_ - - - |
    | 3 - - - | 2 - - - | 1 - - - | 7_ - - - |
    | 1 - - - | 2 - - - | 3 - - - | 2 - - - |

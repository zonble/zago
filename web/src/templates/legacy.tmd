/* =============================================================
   III. 主歌二（v2: 16 小節）
   時間開始流動。吉他切換為後搖標誌性的八分音符分解循環（Arpeggio），
   大鼓像遠處的心跳沉重響起，單簧管伴著鋼琴同度哀鳴。
   ============================================================= */

v2:piano@|-1| {
    <4*>
    /* 多希望  能 夠        還可      以繼  續犯錯 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | 2 1 5_ - |
    /* 一直有   原   諒   和   寬    容*/
    | 0 3 2 3 | 5 - 3 - | 2 - 5 - | 3 - - - |
    /* 多希望  能 夠        稍微      理解   這個      宇宙*/
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | (2 2)%(-) 1 5_ - |
    /* 有沒有   熱   寂     以    外的  結果 */
    | 0 3 2 1 | 7_ - 5_ - | 7_ - 2 3 | 1 6_ - - |
}


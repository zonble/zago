/* =============================================================
   IV. 主歌三（v3: 16 小節）
   儀式感通通鼓推進（Tribal Tom Build-up）！
   通通鼓（Toms: B - B -）猛烈敲打，低音貝斯強烈八分音符驅動，
   重破音電吉他（Distortion）在底層開始嗡鳴加熱！
   ============================================================= */

v3:piano@|-1| {
    <4*>
    /*  我一向  都  平     凡   無     奇*/
    | 0 3 1 3 | 4 - 1 - | 6_ - 4  - | 3 - - - |
    /*  我根本  都  無     足   輕     重*/
    | 0 3 1 3 | 5 - 3 - | 2_ - 5  - | 3 - - - | 
    /*         我   居    然   從來  沒   想過*/
    | - - - - | 4 - 1 - | 6_ (6_ 6_)%(-) 4 3 | 3  1  0 0 |
    /* 物 理   法則       對  誰 都  適用    */
    | 5 - 3 - | 2 5_ 0 0 | 5 - 5 6 | 5 3 - - |
}


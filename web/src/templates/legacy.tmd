/* =============================================================
   V. 主歌四（v4: 16 小節）
   「遺忘的洪流」逼近！左右雙破音吉他全力蓄勢！
   小鼓與開鈸劇烈狂打，在最後兩小節打出連續碎鼓滾奏，引爆音牆！
   ============================================================= */

v4:piano@|-1| {
    <4*>
    /*  我不過  是  肉    體    凡     軀 */
    | 0 3 1 3 | 4 - 1 - | 6_ - 4  - | 3 - - - |
    /*  有什麼  能   被   我    左     右？ */
    | 0 3 1 3 | 5 - 3 - | 2_ - 5  - | 3 - - - | 
    /*         我   還    是   忍不   住  可 惜*/
    | - - - - | 4 - 1 - | 6_ (6_ 6_)%(-) 4 3 | 3  1  0 0 |
    /*不  只    是我         淹沒     在    遺忘   的  洪流   */
    | 5 - 3 - | 2 5_ 0 5_ | (5 5)%(-) 1 (5 5)%(-) 6 | 5 3 - - |
}


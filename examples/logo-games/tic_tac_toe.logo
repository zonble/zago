; ==============================================================================
; Tic-Tac-Toe Game in zago Editor LOGO
; ==============================================================================
; Controls:
;   Enter cell number 1 to 9 (1=Top-Left, 9=Bottom-Right)
;   Q - Quit Game
; Usage in zago:
;   1. Esc -> type: LOAD "examples/logo-games/tic_tac_toe.logo
; ==============================================================================

TO TIC_TAC_TOE
    MAKE "board ["1 "2 "3 "4 "5 "6 "7 "8 "9]
    MAKE "turn "X
    MAKE "playing true
    MAKE "moves 0

    DO.WHILE [
        ERASEALL
        APPEND "+----------------------------+"
        APPEND |\|      zago TIC-TAC-TOE      \||
        APPEND "+----------------------------+"
        MAKE "line WORD |\|| FORMAT |        %s \| %s \| %s           | (ITEM 1 :board) (ITEM 2 :board) (ITEM 3 :board)
        APPEND WORD :line |\||
        APPEND |\|       ---+---+---          \||
        MAKE "line WORD |\|| FORMAT |        %s \| %s \| %s           | (ITEM 4 :board) (ITEM 5 :board) (ITEM 6 :board)
        APPEND WORD :line |\||
        APPEND |\|       ---+---+---          \||
        MAKE "line WORD |\|| FORMAT |        %s \| %s \| %s           | (ITEM 7 :board) (ITEM 8 :board) (ITEM 9 :board)
        APPEND WORD :line |\||
        APPEND "+----------------------------+"
        MAKE "line WORD |\|| FORMAT | Player %s's Turn            | :turn
        APPEND WORD :line |\||
        APPEND "+----------------------------+"

        ; Check win conditions
        MAKE "wins [
            [1 2 3] [4 5 6] [7 8 9]
            [1 4 7] [2 5 8] [3 6 9]
            [1 5 9] [3 5 7]
        ]

        MAKE "winner ""
        FOREACH :wins [
            MAKE "combo ?
            MAKE "a ITEM (ITEM 1 :combo) :board
            MAKE "b ITEM (ITEM 2 :combo) :board
            MAKE "c ITEM (ITEM 3 :combo) :board
            IF AND (:a = :b) (:b = :c) [
                MAKE "winner :a
            ]
        ]

        IFELSE :winner != "" [
            APPEND ""
            APPEND FORMAT "PLAYER %s WINS! CONGRATULATIONS!" :winner
            MAKE "playing false
        ] [
            IFELSE :moves = 9 [
                APPEND ""
                APPEND "IT'S A DRAW / TIE GAME!"
                MAKE "playing false
            ] [
                MAKE "choice READWORD FORMAT "Player %s, enter position (1-9) or Q: " :turn
                MAKE "choice TRIM :choice

                IFELSE OR ((LOWERCASE :choice) = "q) (:choice = "") [
                    APPEND "Game Quit."
                    MAKE "playing false
                ] [
                    MAKE "pos INT :choice
                    IF AND (:pos >= 1) (:pos <= 9) [
                        MAKE "curr ITEM :pos :board
                        IFELSE AND (:curr != "X) (:curr != "O) [
                            SETITEM :pos :board :turn
                            MAKE "moves (:moves + 1)
                            IFELSE :turn = "X [ MAKE "turn "O ] [ MAKE "turn "X ]
                        ] [
                            APPEND "Cell already taken! Try again."
                        ]
                    ]
                ]
            ]
        ]
    ][ :playing = true ]
END

TIC_TAC_TOE

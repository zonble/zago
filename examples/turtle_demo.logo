; ==============================================================================
; Turtle Graphics Demonstration Example (in zago Editor LOGO)
; ==============================================================================
; Demonstrates LOGO turtle drawing primitives: `PENDOWN` (`PD`), `PENUP` (`PU`),
; `FORWARD` (`FD`), `BACK` (`BK`), `TURNRIGHT` (`RT`), `TURNLEFT` (`LT`),
; `SETHEADING` (`SETH`).
; ==============================================================================

TYPE "===_Turtle_Graphics_Demo_==="
TYPE CHAR 10

; 1. Lower the pen and draw a 5x5 square box using REPEAT loop
PENDOWN
REPEAT 4 [
    FORWARD 5
    TURNRIGHT 90
]

; 2. Lift the pen, move turtle back and change heading
PENUP
BACK 2
SETHEADING "RIGHT"

; 3. Draw a second box starting from new heading
PENDOWN
REPEAT 4 [
    FORWARD 4
    TURNRIGHT 90
]
PENUP

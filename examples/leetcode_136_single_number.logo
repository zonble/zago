; ==============================================================================
; LeetCode 136: Single Number (in zago Editor LOGO)
; ==============================================================================
; Given a non-empty list of integers `nums`, every element appears twice
; except for one. Find that single one using `BIT.XOR`.
; ==============================================================================

TO SINGLENUMBER :nums
  MAKE "res 0
  FOREACH :nums [
    MAKE "res BIT.XOR :res ?
  ]
  OUTPUT :res
END

; Test cases
TYPE "===_LeetCode_136:_Single_Number_===
TYPE CHAR 10

MAKE "nums1 [4 1 2 1 2]
TYPE FORMAT "nums:_%s_single:_%d (LIST :nums1 (SINGLENUMBER :nums1))
TYPE CHAR 10

MAKE "nums2 [2 2 1]
TYPE FORMAT "nums:_%s_single:_%d (LIST :nums2 (SINGLENUMBER :nums2))
TYPE CHAR 10

; ==============================================================================
; LeetCode 1: Two Sum (in zago Editor LOGO)
; ==============================================================================
; Given an array of integers `nums` and an integer `target`, return 1-based
; indices of the two numbers such that they add up to target.
; ==============================================================================

TO TWOSUM :nums :target
  MAKE "n COUNT :nums
  MAKE "i 1
  WHILE [:i <= :n] [
    MAKE "v1 ITEM :i :nums
    MAKE "j :i + 1
    WHILE [:j <= :n] [
      MAKE "v2 ITEM :j :nums
      IF (:v1 + :v2) = :target [
        OUTPUT LIST :i :j
      ]
      MAKE "j :j + 1
    ]
    MAKE "i :i + 1
  ]
  OUTPUT []
END

; Test cases
TYPE "===_LeetCode_001:_Two_Sum_===
TYPE CHAR 10

MAKE "nums1 [2 7 11 15]
MAKE "target1 9
TYPE FORMAT "nums:_%s,_target:_%d_=>_indices:_%s (LIST :nums1 :target1 (TWOSUM :nums1 :target1))
TYPE CHAR 10

MAKE "nums2 [3 2 4]
MAKE "target2 6
TYPE FORMAT "nums:_%s,_target:_%d_=>_indices:_%s (LIST :nums2 :target2 (TWOSUM :nums2 :target2))
TYPE CHAR 10
